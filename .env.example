# Copy this file to .env and fill in your keys. Never commit .env.

PORT=3000
APP_URL=http://localhost:3000

# --- Grok (xAI) --- https://console.x.ai
XAI_API_KEY=xai-...
# Check the current model list in the xAI console and paste an ID here
GROK_MODEL=grok-4.7

# --- Qwen on Cerebras Cloud --- https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk-...
# Check https://inference-docs.cerebras.ai/models for the current Qwen model ID
CEREBRAS_MODEL=qwen-3-32b

# --- Stripe (TEST MODE keys only: sk_test_...) --- https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Platform fee you keep from each booking, in percent
PLATFORM_FEE_PERCENT=10
